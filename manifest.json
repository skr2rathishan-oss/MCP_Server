{
  "manifest_version": "0.4",
  "name": "weather",
  "display_name": "Weather MCP",
  "version": "0.1.0",
  "description": "Weather MCP server.",
  "author": {
    "name": "Rathishan"
  },
  "server": {
    "type": "uv",
    "entry_point": "src/weather/__init__.py",
    "mcp_config": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${__dirname}",
        "python",
        "${__dirname}/src/weather/__init__.py"
      ]
    }
  }
}